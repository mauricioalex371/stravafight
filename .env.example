# ==============================================================================
# STRAVA FIGHT — Variáveis de Ambiente para Produção (Vercel & Supabase)
# Domínio Oficial: https://stravafight.com.br
# ==============================================================================

# 1. Supabase (PostgreSQL, Auth & Storage)
# Obtenha em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anonima-publica"

# 2. Configurações da Aplicação
VITE_APP_URL="https://stravafight.com.br"
VITE_ENVIRONMENT="production"

# 3. Gemini AI API (Opcional - para recursos de IA no servidor)
# AI Studio injeta automaticamente em runtime via Secrets quando configurado.
GEMINI_API_KEY="seu-token-gemini-opcional"
